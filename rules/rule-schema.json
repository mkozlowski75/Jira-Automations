        {
          "if": {
            "properties": {
              "type": {
                "const": "jira.sprint.event.trigger:started"
              },
              "schemaVersion": {
                "const": 1
              }
            },
            "required": [
              "type",
              "schemaVersion"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "component": {
                "const": "TRIGGER"
