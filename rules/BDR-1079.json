      "children": [
        {
          "id": "144680",
          "component": "CONDITION_BLOCK",
          "parentId": "144679",
          "schemaVersion": 1,
          "type": "jira.condition.if.block",
          "value": {
            "conditionMatchType": "ALL"
          },
          "children": [
            {
              "id": "144682",
              "component": "ACTION",
              "parentId": "144680",
              "schemaVersion": 1,
              "type": "codebarrel.action.log",
              "value": "Release-Auftrag an Worker 875: Komponente={{component}} | Release-Version={{releaseVersion}} | Fix-Version={{workerFixVersion}} | Sprint-ID={{workerSprintId}} | Quell-Ticket={{issue.key}}",
              "children": [],
              "conditions": []
            },
            {
              "id": "144683",
              "component": "ACTION",
              "parentId": "144680",
              "schemaVersion": 2,
              "type": "jira.issue.outgoing.webhook",
              "value": {
                "url": "https://partner.bdr.de/jira/rest/cb-automation/latest/hooks/d4d44fdd080e726948539f84d543b3336ef42ba4",
                "headers": [],
                "sendIssue": false,
                "contentType": "custom",
                "customBody": "{\n  \"component\": \"{{component}}\",\n  \"releaseVersion\": \"{{releaseVersion}}\",\n  \"sprintId\": \"{{workerSprintId}}\",\n  \"sprintName\": \"{{issue.sprint.last.name}}\",\n  \"fixVersion\": \"{{workerFixVersion}}\",\n  \"origin\": \"manual-rule-1079\",\n  \"sourceIssueKey\": \"{{issue.key}}\"\n}",
                "method": "POST",
                "responseEnabled": true,
                "usedSecretsKeys": []
              },
              "children": [],
              "conditions": []
            }
          ],
          "conditions": [
            {
              "id": "144681",
              "component": "CONDITION",
              "conditionParentId": "144680",
              "schemaVersion": 1,
              "type": "jira.comparator.condition",
              "value": {
                "first": "{{component}}|{{releaseVersion}}|{{workerSprintId}}",
                "second": "^(CeromaCore|Benutzerhandbuch|Mediator|PostIdentService)\\|[^|]+\\|[0-9]+$",
                "operator": "REGEX_MATCHES"
              },
              "children": [],
              "conditions": []
            }
          ]
        }
      ],
      "conditions": []
    },
