{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://partner.bdr.de/schemas/codebarrel-automation-rule.json",
  "title": "Jira Data Center Code Barrel Automation Rule",
  "description": "Struktur eines rohen Exports aus Automation for Jira (Code Barrel).",
  "type": "object",
  "required": [
    "id",
    "clientKey",
    "name",
    "state",
    "canOtherRuleTrigger",
    "notifyOnError",
    "authorAccountId",
    "actorAccountId",
    "created",
    "updated",
    "trigger",
    "components",
    "projects",
    "labels",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1,
      "description": "Numerische, von Jira vergebene Regel-ID."
    },
    "clientKey": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "ENABLED",
        "DISABLED"
      ]
    },
    "description": {
      "type": "string"
    },
    "canOtherRuleTrigger": {
      "type": "boolean"
    },
    "notifyOnError": {
      "type": "string",
      "enum": [
        "FIRSTERROR",
        "EVERYERROR"
      ]
    },
    "authorAccountId": {
      "type": "string",
      "minLength": 1
    },
    "actorAccountId": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "integer",
      "minimum": 0
    },
    "updated": {
      "type": "integer",
      "minimum": 0
    },
    "trigger": {
      "allOf": [
        {
          "$ref": "#/$defs/componentNode"
        },
        {
          "properties": {
            "component": {
              "const": "TRIGGER"
            }
          }
        }
      ]
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/componentNode"
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "tags": {
      "type": "array"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "project": {
      "type": "object",
      "required": [
        "projectId",
        "projectTypeKey"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^\\d+$"
        },
        "projectTypeKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "componentNode": {
      "type": "object",
      "required": [
        "id",
        "component",
        "schemaVersion",
        "type",
        "children",
        "conditions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^\\d+$"
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "value": true,
        "parentId": {
          "type": "string",
          "pattern": "^\\d+$"
        },
        "conditionParentId": {
          "type": "string",
          "pattern": "^\\d+$"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentNode"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentNode"
          }
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "codebarrel.action.log"
              },
              "schemaVersion": {
                "const": 1
              }
            },
            "required": [
              "type",
              "schemaVersion"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "component": {
                "const": "ACTION"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "com.xiplink.jira.git.jira_git_plugin:pull-request-merged-trigger"
              },
              "schemaVersion": {
                "const": 1
              }
            },
            "required": [
              "type",
              "schemaVersion"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "component": {
                "const": "TRIGGER"
              },
              "value": {
                "$ref": "#/$defs/pullRequestMergedValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "jira.comparator.condition"
              },
              "schemaVersion": {
                "const": 1
              }
            },
            "required": [
              "type",
              "schemaVersion"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "component": {
                "const": "CONDITION"
              },
              "value": {
                "$ref": "#/$defs/comparatorConditionValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "jira.condition.container.block"
              },
              "schemaVersion": {
                "const": 1
              }
            },
            "required": [
              "type",
              "schemaVersion"
            ]
          },
          "then": {
            "properties": {
              "component": {
                "const": "CONDITION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "jira.condition.if.block"
              },
              "schemaVersion": {
                "const": 1
              }
            },
            "required": [
              "type",
              "schemaVersion"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "component": {
                "const": "CONDITION_BLOCK"
              },
              "value": {
                "$ref": "#/$defs/ifBlockValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "jira.create.variable"
              },
              "schemaVersion": {
                "const": 1
              }
            },
            "required": [
              "type",
              "schemaVersion"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "component": {
                "const": "ACTION"
              },
              "value": {
                "$ref": "#/$defs/createVariableValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "jira.incoming.webhook"
              },
              "schemaVersion": {
                "const": 1
              }
            },
            "required": [
              "type",
              "schemaVersion"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "component": {
                "const": "TRIGGER"
              },
              "value": {
                "$ref": "#/$defs/incomingWebhookValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "jira.issue.assign"
              },
              "schemaVersion": {
                "const": 3
              }
            },
            "required": [
              "type",
              "schemaVersion"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "component": {
                "const": "ACTION"
              },
              "value": {
                "$ref": "#/$defs/issueAssignValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "jira.issue.comment"
              },
              "schemaVersion": {
                "const": 1
              }
            },
            "required": [
              "type",
              "schemaVersion"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "component": {
                "const": "ACTION"
              },
              "value": {
                "$ref": "#/$defs/issueCommentValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "jira.issue.condition"
              },
              "schemaVersion": {
                "const": 3
              }
            },
            "required": [
              "type",
              "schemaVersion"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "component": {
                "const": "CONDITION"
              },
              "value": {
                "$ref": "#/$defs/issueConditionValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "jira.issue.create"
              },
              "schemaVersion": {
                "const": 6
              }
            },
            "required": [
              "type",
              "schemaVersion"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "component": {
                "const": "ACTION"
              },
              "value": {
                "$ref": "#/$defs/issueCreateValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "jira.issue.edit"
              },
              "schemaVersion": {
                "const": 6
              }
            },
            "required": [
              "type",
              "schemaVersion"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "component": {
                "const": "ACTION"
              },
              "value": {
                "$ref": "#/$defs/issueEditValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "jira.issue.event.trigger:transitioned"
              },
              "schemaVersion": {
                "const": 1
              }
            },
            "required": [
              "type",
              "schemaVersion"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "component": {
                "const": "TRIGGER"
              },
              "value": {
                "$ref": "#/$defs/transitionedTriggerValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "jira.issue.link"
              },
              "schemaVersion": {
                "const": 2
              }
            },
            "required": [
              "type",
              "schemaVersion"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "component": {
                "const": "ACTION"
              },
              "value": {
                "$ref": "#/$defs/issueLinkValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "jira.issue.outgoing.email"
              },
              "schemaVersion": {
                "const": 3
              }
            },
            "required": [
              "type",
              "schemaVersion"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "component": {
                "const": "ACTION"
              },
              "value": {
                "$ref": "#/$defs/outgoingEmailValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "jira.issue.outgoing.webhook"
              },
              "schemaVersion": {
                "const": 2
              }
            },
            "required": [
              "type",
              "schemaVersion"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "component": {
                "const": "ACTION"
              },
              "value": {
                "$ref": "#/$defs/outgoingWebhookValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "jira.issue.related"
              },
              "schemaVersion": {
                "const": 1
              }
            },
            "required": [
              "type",
              "schemaVersion"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "component": {
                "const": "BRANCH"
              },
              "value": {
                "$ref": "#/$defs/relatedIssuesValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "jira.issue.transition"
              },
              "schemaVersion": {
                "const": 6
              }
            },
            "required": [
              "type",
              "schemaVersion"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "component": {
                "const": "ACTION"
              },
              "value": {
                "$ref": "#/$defs/issueTransitionValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "jira.jql.scheduled"
              },
              "schemaVersion": {
                "const": 1
              }
            },
            "required": [
              "type",
              "schemaVersion"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "component": {
                "const": "TRIGGER"
              },
