{
  "id": 1079,
  "clientKey": "com.codebarrel.tenant.global",
  "name": "Jira: Create Release Ticket From Issue",
  "state": "ENABLED",
  "description": "Erstellt auf Anforderung aus einem CER-Ticket ein Release-Ticket. Die Regel liest die letzte Komponente, Fix-Version und Sprint-ID des aktuellen Tickets, prüft die Werte und übergibt sie an den Release-Ticket-Worker. Bei fehlenden oder nicht unterstützten Daten wird kein Release-Auftrag gesendet.",
  "canOtherRuleTrigger": false,
  "notifyOnError": "FIRSTERROR",
  "authorAccountId": "JIRAUSER15085",
  "actorAccountId": "JIRAUSER15085",
