{
  "name": "bdr-jira-automations",
  "version": "1.0.0",
  "description": "Sichere Entwicklung und Bereitstellung von Jira-Data-Center-Automatisierungsregeln",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/rule-validation.test.mjs test/ticket-api.test.mjs test/cve-ticket-factory.test.mjs test/gitlab-api.test.mjs test/confluence-api.test.mjs && node scripts/lint-skill.mjs",
    "validate": "node scripts/validate-rules.mjs",
    "verify": "npm test && npm run validate",
    "next-component-id": "node scripts/next-component-id.mjs",
    "inspect-environment": "node scripts/inspect-environment.mjs",
    "pull-rule": "node scripts/pull-rule.mjs",
    "push-rule": "node scripts/push-rule.mjs",
    "rollback-rule": "node scripts/rollback-rule.mjs",
    "jira-ticket": "node .github/skills/jira-tickets/scripts/jira-ticket.mjs",
    "create-cve-ticket": "node scripts/create-cve-ticket.mjs",
    "gitlab-api": "node .github/skills/gitlab-access/scripts/gitlab-api.mjs",
    "confluence-page": "node .github/skills/confluence-pages/scripts/confluence-page.mjs",
    "lint": "node scripts/lint-skill.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "ajv": "^8.17.1"
  },
  "engines": {
    "node": ">=18"
  }
}
