              "type",
              "schemaVersion"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "component": {
                "const": "TRIGGER"
              },
              "value": {
                "$ref": "#/$defs/manualTriggerValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "jira.multiple.issue.event"
              },
              "schemaVersion": {
                "const": 1
              }
            },
            "required": [
              "type",
              "schemaVersion"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "component": {
