      ]
    },
    "pullRequestMergedValue": {
      "type": "object",
      "required": [
        "isCustomized",
        "prMode"
      ],
      "properties": {
        "isCustomized": {
          "type": "boolean"
        },
        "prMode": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "comparatorConditionValue": {
