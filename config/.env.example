# Jira Data Center (https://partner.bdr.de) – Kontextpfad: /jira
JIRA_BASE_URL=https://partner.bdr.de
JIRA_API_PATH=/jira/rest/api/2
JIRA_PERSONAL_ACCESS_TOKEN=your-jira-personal-access-token

# Confluence Data Center (https://partner.bdr.de) – Kontextpfad: /confluence
CONFLUENCE_BASE_URL=https://partner.bdr.de
CONFLUENCE_API_PATH=/confluence/rest/api
CONFLUENCE_PERSONAL_ACCESS_TOKEN=your-confluence-personal-access-token

# Client-SSL-Zertifikat (mTLS) – Pfad zur .pfx-Datei und Passphrase
CLIENT_CERT_PATH=D:\path\to\your-certificate.pfx
CLIENT_CERT_PASSPHRASE=your-certificate-passphrase

# Optional: zusätzliche CA für die Prüfung des Jira-Serverzertifikats
# SERVER_CA_PATH=D:\path\to\your-server-ca.pem

# GitLab Self-Managed (für den Skill .github/skills/gitlab-access)
# Die URL darf optional bereits mit /api/v4 enden.
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_API_TOKEN=your-gitlab-api-token

# Optional: beschränkt die Projektliste des GitLab-Skills auf diese Gruppe.
# GITLAB_DEFAULT_GROUP=your-group/subgroup
